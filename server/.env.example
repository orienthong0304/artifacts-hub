# Postgres 连接串（库名 artifacts_platform，需提前 create database）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artifacts_platform

# JWT 签名密钥（生产必填，建议 openssl rand -hex 32 生成）
JWT_SECRET=

# 监听端口（默认 8091）
PORT=8091

# 该邮箱注册的账号自动成为管理员
ADMIN_EMAIL=

# 生产环境设为 production（cookie 加 Secure）
NODE_ENV=development

# 渲染器源（契约 §3.10 子域 shell 内嵌 runner iframe）；缺省即生产渲染子域，本地联调可指 http://localhost:5174
RUNNER_ORIGIN=https://run.artifacts.orienthong.cn

# 阿里云内容安全（文本审核增强版）；留空则关闭云端机审，仅本地敏感词生效
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_GREEN_SERVICE=ugc_moderation_byllm

# ---------- 自托管参数（dual-track roadmap OS-2/OS-3；不设即为 SaaS 生产默认） ----------

# 用户模型：multi（默认，开放注册）| single（单用户自托管：首个注册者即管理员，此后注册关闭）
# AUTH_MODE=single

# 内容审核：cloud（默认：本地词表 + 阿里云机审 + trusted 闸门）| off（全关，自己对自己的内容负责）
# MODERATION_MODE=off

# 主域后缀（换域主开关）：site.url、子域 shell、CSRF 白名单全部由它派生
# SITES_DOMAIN_SUFFIX=artifacts.orienthong.cn

# 站点文件存储根目录（默认 ./sites-data，生产 /app/sites 卷挂载）
# SITES_ROOT=./sites-data

# free 档站点配额 env 覆盖口（契约 §3.12，默认 3；0 = 不限）
# SITE_QUOTA_PER_USER=3

# 敏感词词表路径（缺省用仓库示例词表，生产请挂载真实词表）
# SENSITIVE_WORDS_PATH=/app/sensitive-words.txt

# 额外允许的 CSRF Origin（逗号分隔）——非常规部署（如前端独立域）才需要
# EXTRA_ALLOWED_ORIGIN=

# 公示信息（缺省为本站生产值；海外自托管可将 ICP_NUMBER 置空以隐藏备案行）
# OPERATOR_NAME=
# ICP_NUMBER=
# CONTACT_EMAIL=
