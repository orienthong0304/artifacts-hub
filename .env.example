# Artifacts 自托管 · docker compose 环境变量（复制为 .env 后修改）

# 必配：登录态签名密钥（随机长串）
JWT_SECRET=

# 数据库口令（compose 内部使用）
POSTGRES_PASSWORD=artifacts

# 实例形态（README「部署模式」）：single/off = 单用户私域（默认）
AUTH_MODE=single
MODERATION_MODE=off

# 对外地址（本机体验保持默认；上域名后改成你的正式地址）
SITE_ORIGIN=http://localhost:8080
RUNNER_ORIGIN=http://localhost:8081
# 主域（不带协议）：子域功能与 runner 嵌入白名单用
MAIN_HOST=localhost
SITES_DOMAIN_SUFFIX=localhost

# 页脚公示（可全部留空；ICP 留空则备案行整块隐藏）
OPERATOR_NAME=
ICP_NUMBER=
CONTACT_EMAIL=

# MODERATION_MODE=cloud 时才需要
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
